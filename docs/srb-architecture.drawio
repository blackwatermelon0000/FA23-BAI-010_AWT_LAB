" parent="1"><mxGeometry x="40" y="440" width="370" height="134" as="geometry"/></mxCell><mxCell id="v-43" value="PK  regNo : String  (unique, e.g. FA23-BCS-045)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;fontStyle=1;" vertex="1" parent="v-42"><mxGeometry x="0" y="30" width="370" height="26" as="geometry"/></mxCell><mxCell id="v-44" value="    _id : ObjectId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-42"><mxGeometry x="0" y="56" width="370" height="26" as="geometry"/></mxCell><mxCell id="v-45" value="    name : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-42"><mxGeometry x="0" y="82" width="370" height="26" as="geometry"/></mxCell><mxCell id="v-46" value="    email : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-42"><mxGeometry x="0" y="108" width="370" height="26" as="geometry"/></mxCell><mxCell id="v-47" value="Booking" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="360" height="160" as="geometry"/></mxCell><mxCell id="v-48" value="PK  _id : ObjectId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;fontStyle=1;" vertex="1" parent="v-47"><mxGeometry x="0" y="30" width="360" height="26" as="geometry"/></mxCell><mxCell id="v-49" value="FK  student : ObjectId  -&amp;gt; Student._id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-47"><mxGeometry x="0" y="56" width="360" height="26" as="geometry"/></mxCell><mxCell id="v-50" value="FK  slot : ObjectId  -&amp;gt; Slot._id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-47"><mxGeometry x="0" y="82" width="360" height="26" as="geometry"/></mxCell><mxCell id="v-51" value="    createdAt : Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-47"><mxGeometry x="0" y="108" width="360" height="26" as="geometry"/></mxCell><mxCell id="v-52" value="UQ  (student, slot)  no double booking" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="v-47"><mxGeometry x="0" y="134" width="360" height="26" as="geometry"/></mxCell><mxCell id="e-53" value="has  (1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v-29" target="v-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-54" value="makes  (1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v-42" target="v-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-55" value="is booked in  (1 : 0..*)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERzeroToMany;endFill=0;startFill=0;" edge="1" parent="1" source="v-34" target="v-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v-56" value="Cardinality&lt;br&gt;• One Room has zero or many Slots; every Slot belongs to exactly one Room.&lt;br&gt;• One Student makes zero or many Bookings; every Booking has exactly one Student.&lt;br&gt;• One Slot has zero or many Bookings (at most Slot.seats); every Booking is for exactly one Slot.&lt;br&gt;• Student and Slot are many-to-many, resolved through Booking.&lt;br&gt;• Unique index (student, slot) means a student cannot book the same slot twice." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="940" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sequence-book-slot" name="Sequence - book slot"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v-57" value="Sequence diagram - student books a slot (including the &quot;slot is full&quot; case)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="v-58" value="Student&lt;br&gt;(Postman)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="v-59" value="Express route +&lt;br&gt;BookingController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="v-60" value="BookingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="v-61" value="MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="v-62" value="Socket.IO server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="1030" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="v-63" value="Boards open for&lt;br&gt;this roomCode" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="1260" y="60" width="170" height="1000" as="geometry"/></mxCell><mxCell id="e-64" value="POST /api/v1/students/:regNo/bookings { slotId }" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="140" as="sourcePoint"/><mxPoint x="335" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-65" value="bookSlot(regNo, slotId)" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="175" as="sourcePoint"/><mxPoint x="565" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-66" value="Student.findOne({ regNo })" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="210" as="sourcePoint"/><mxPoint x="885" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-67" value="student" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="235" as="sourcePoint"/><mxPoint x="565" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-68" value="Slot.findById(slotId)" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="270" as="sourcePoint"/><mxPoint x="885" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-69" value="slot" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="295" as="sourcePoint"/><mxPoint x="565" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-70" value="Booking.exists({ student, slot })" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="330" as="sourcePoint"/><mxPoint x="885" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-71" value="null (not booked yet)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="355" as="sourcePoint"/><mxPoint x="565" y="355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v-72" value="Earlier exits (not drawn): bad slotId -&amp;gt; 400;&lt;br&gt;student or slot not found -&amp;gt; 404;&lt;br&gt;already booked -&amp;gt; 409 ALREADY_BOOKED" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="1090" y="190" width="280" height="60" as="geometry"/></mxCell><mxCell id="e-73" value="Slot.findOneAndUpdate(&lt;br&gt;{ _id, $expr: { $lt: [&quot;$booked&quot;, &quot;$seats&quot;] } },&lt;br&gt;{ $inc: { booked: 1 } })" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="420" as="sourcePoint"/><mxPoint x="885" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-74" value="updated slot  OR  null" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="445" as="sourcePoint"/><mxPoint x="565" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v-75" value="single atomic update: two students&lt;br&gt;can never both take the last seat" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="1150" y="380" width="230" height="46" as="geometry"/></mxCell><mxCell id="v-76" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="100" y="465" width="1300" height="445" as="geometry"/></mxCell><mxCell id="v-77" value="[updated != null : a seat was free]" style="text;html=1;fontStyle=2;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="160" y="465" width="300" height="24" as="geometry"/></mxCell><mxCell id="e-78" value="Booking.create({ student, slot })" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="510" as="sourcePoint"/><mxPoint x="885" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-79" value="booking" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="535" as="sourcePoint"/><mxPoint x="565" y="535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-80" value="events.emit(&quot;slot:updated&quot;, slot)" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="575" as="sourcePoint"/><mxPoint x="1115" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-81" value="io.to(roomCode).emit(&lt;br&gt;&quot;slot:updated&quot;, { slotId, seatsLeft })" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1115" y="615" as="sourcePoint"/><mxPoint x="1345" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v-82" value="only sockets in this roomCode's room; boards of other rooms get nothing" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="1150" y="630" width="230" height="46" as="geometry"/></mxCell><mxCell id="e-83" value="booking (+ seatsLeft)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="650" as="sourcePoint"/><mxPoint x="335" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-84" value="201 Created  { booking }" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="685" as="sourcePoint"/><mxPoint x="125" y="685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-85" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="720" as="sourcePoint"/><mxPoint x="1400" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v-86" value="[updated == null : booked == seats, slot is full]" style="text;html=1;fontStyle=2;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="722" width="360" height="24" as="geometry"/></mxCell><mxCell id="e-87" value="throw AppError(409, &quot;Slot is full&quot;, &quot;SLOT_FULL&quot;)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="785" as="sourcePoint"/><mxPoint x="335" y="785" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-88" value="409 Conflict (SLOT_FULL)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="835" as="sourcePoint"/><mxPoint x="125" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v-89" value="error handler sends:&lt;br&gt;{ &quot;error&quot;: { &quot;status&quot;: 409, &quot;code&quot;: &quot;SLOT_FULL&quot;, &quot;message&quot;: &quot;Slot is full&quot; } }&lt;br&gt;booked is unchanged, no Booking is created, no slot:updated is emitted" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="380" y="830" width="420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
